# Runtime configuration (Coolify env vars in production; .env locally for `npm run dev`).
NODE_ENV=development
PORT=7001
# CORS: production frontend origin, plus an optional local one
FRONTEND_URL=https://www.estebanbasili.com
FRONTEND_LOCAL_URL=http://localhost:5173
# Cloudinary (photography)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
